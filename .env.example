# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=helmet_detection
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/helmet_detection

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your_secret_key_minimum_32_characters_long_random_string

# Model Configuration
MODEL_PATH=data/models/helmet_detector_best.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
DEVICE=auto  # auto, cuda, cpu

# Video Processing
MAX_VIDEO_SIZE_MB=500
SUPPORTED_FORMATS=mp4,avi,mov,mkv
OUTPUT_FPS=30

# Tracking Configuration
MAX_TRACK_AGE=30
MIN_TRACK_HITS=3
TRACKING_IOU_THRESHOLD=0.3

# Risk Assessment
RISK_WARNING_THRESHOLD=30.0
RISK_CRITICAL_THRESHOLD=60.0
RISK_EMERGENCY_THRESHOLD=80.0

# Alert Configuration
ENABLE_EMAIL_ALERTS=false
ENABLE_SMS_ALERTS=false
ENABLE_WEBHOOK_ALERTS=false
ALERT_COOLDOWN_SECONDS=60

# Email Configuration (if ENABLE_EMAIL_ALERTS=true)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
ALERT_EMAIL_TO=safety@company.com

# SMS Configuration (if ENABLE_SMS_ALERTS=true)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_FROM=+1234567890
ALERT_SMS_TO=+1234567890

# Webhook Configuration (if ENABLE_WEBHOOK_ALERTS=true)
WEBHOOK_URL=https://your-webhook-endpoint.com/alerts
WEBHOOK_AUTH_TOKEN=your_webhook_token

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
FLOWER_PORT=5555

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json, text
LOG_FILE=logs/helmet_detection.log
MAX_LOG_SIZE_MB=100
LOG_BACKUP_COUNT=5

# Performance Configuration
ENABLE_PERFORMANCE_MONITORING=true
BATCH_SIZE=16
MAX_WORKERS=8
ENABLE_GPU=true

# Storage Configuration
UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs
MODEL_DIR=data/models
RETENTION_DAYS=90  # How long to keep processed videos

# Feature Flags
ENABLE_TRACKING=true
ENABLE_RISK_ASSESSMENT=true
ENABLE_HAZARD_ZONES=true
ENABLE_ANALYTICS=true
ENABLE_REPORTING=true

# Development/Debug
DEBUG=false
RELOAD_ON_CHANGE=false
ENABLE_CORS=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Production Settings (set these in production)
ENVIRONMENT=development  # development, staging, production
SENTRY_DSN=  # Your Sentry DSN for error tracking
